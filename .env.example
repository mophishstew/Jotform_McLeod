# =============================================================================
# Jotform McLeod Integration - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# McLeod TMS REST API Configuration
# CRITICAL: McLeod uses REST API, NOT SOAP. All endpoints are under /ws/api
# -----------------------------------------------------------------------------

# Base URL for McLeod REST API (include /ws/api)
MCLEOD_BASE_URL=https://tms-bkxg.mcleodhosted.com/ws/api

# Authentication Mode: token | basic | login
# - token: Use a pre-existing token from MCLEOD_TOKEN
# - basic: Use Basic Auth header for every request (username:password)
# - login: POST to /users/login to get a Bearer token (recommended)
MCLEOD_AUTH_MODE=login

# McLeod API credentials (required for 'basic' or 'login' auth modes)
MCLEOD_USERNAME=api_service_user
MCLEOD_PASSWORD=your_secure_password

# Pre-existing API token (required for 'token' auth mode)
# If your McLeod system provides long-lived tokens, use this instead of login
MCLEOD_TOKEN=

# McLeod Anywhere Company ID (may be required for multi-tenant systems)
MCLEOD_ANYWHERE_COMPANY_ID=TMS

# Document type ID for agreement uploads via ImagingService
# This should match a valid document type in your McLeod configuration
MCLEOD_AGREEMENT_DOCUMENT_TYPE_ID=AGREEMENT

# API timeout in milliseconds (default: 30000 = 30 seconds)
MCLEOD_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Jotform Configuration
# -----------------------------------------------------------------------------

# Jotform API key (get from Jotform Account Settings > API)
JOTFORM_API_KEY=your_jotform_api_key

# Form ID (optional - for filtering/validation)
JOTFORM_FORM_ID=

# Webhook signature secret (optional but recommended for security)
# Set this in Jotform webhook settings to enable signature validation
JOTFORM_WEBHOOK_SECRET=your_webhook_secret

# -----------------------------------------------------------------------------
# Slack Alerts Configuration
# -----------------------------------------------------------------------------

# Slack incoming webhook URL for alerts
# Create at: https://api.slack.com/apps > Your App > Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Enable/disable Slack alerts (true/false)
ENABLE_SLACK_ALERTS=true

# -----------------------------------------------------------------------------
# Azure Table Storage (for persistent idempotency)
# Recommended for production to prevent duplicate processing in serverless
# -----------------------------------------------------------------------------

# Connection string for Azure Table Storage
# Get from Azure Portal > Storage Account > Access Keys
AZURE_TABLE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Table name for storing idempotency records
AZURE_IDEMPOTENCY_TABLE_NAME=JotformIdempotency

# -----------------------------------------------------------------------------
# Azure Blob Storage (for document fallback when McLeod Imaging fails)
# -----------------------------------------------------------------------------

# Connection string for Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Container name for storing agreement documents
AZURE_BLOB_CONTAINER_NAME=customer-agreements

# Legacy vars (for backward compatibility - use the new ones above)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=customer-agreements

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable document upload feature (true/false)
ENABLE_DOCUMENT_UPLOAD=true

# Enable webhook signature validation (true/false)
ENABLE_WEBHOOK_VALIDATION=true

# Re-fetch submission from Jotform API to validate webhook payload
# Adds extra security but increases latency
ENABLE_REFETCH_SUBMISSION=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Local Development Only
# -----------------------------------------------------------------------------

# Azure Functions runtime settings (auto-configured when deployed to Azure)
# For local development with Azure Functions Core Tools:
# AzureWebJobsStorage=UseDevelopmentStorage=true
# FUNCTIONS_WORKER_RUNTIME=node
