# =============================================================================
# Jotform McLeod Integration - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# McLeod TMS Configuration
# -----------------------------------------------------------------------------
# Base URL for McLeod Web Services (without trailing slash)
MCLEOD_API_URL=https://mcleod.yourcompany.com/webservices

# McLeod API credentials (use a dedicated service account)
MCLEOD_USERNAME=api_service_user
MCLEOD_PASSWORD=your_secure_password

# API timeout in milliseconds (default: 30000 = 30 seconds)
MCLEOD_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Jotform Configuration
# -----------------------------------------------------------------------------
# Jotform API key (get from Jotform Account Settings > API)
JOTFORM_API_KEY=your_jotform_api_key

# Webhook signature secret (optional but recommended)
# Set this in Jotform webhook settings to enable signature validation
JOTFORM_WEBHOOK_SECRET=your_webhook_secret

# -----------------------------------------------------------------------------
# Slack Alerts Configuration
# -----------------------------------------------------------------------------
# Slack incoming webhook URL for alerts
# Create at: https://api.slack.com/apps > Your App > Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Enable/disable Slack alerts (true/false)
ENABLE_SLACK_ALERTS=true

# -----------------------------------------------------------------------------
# Azure Blob Storage (for document fallback)
# -----------------------------------------------------------------------------
# Full connection string from Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Container name for storing agreement documents
AZURE_STORAGE_CONTAINER=customer-agreements

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable document upload feature
ENABLE_DOCUMENT_UPLOAD=true

# Enable webhook signature validation
ENABLE_WEBHOOK_VALIDATION=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Local Development Only
# -----------------------------------------------------------------------------
# Azure Functions runtime settings (auto-configured in Azure)
# AzureWebJobsStorage=UseDevelopmentStorage=true
# FUNCTIONS_WORKER_RUNTIME=node
